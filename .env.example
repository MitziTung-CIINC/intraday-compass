# Copy this file to .env.local only when local timing overrides are needed.
# The bundled public Eastmoney bridge does not require an API key.
EASTMONEY_CONTEXT_REFRESH_MS=5000
EASTMONEY_DAILY_REFRESH_MS=21600000
EASTMONEY_MAPPING_REFRESH_MS=86400000
EASTMONEY_MINUTE_MAX_AGE_MS=90000
EASTMONEY_PRICE_TOLERANCE_PCT=1
T0_LATEST_MAX_AGE_MS=15000
