[Unit]
Description=Intraday Compass verified midday bond radar publisher
After=network-online.target intraday-compass-web.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/intraday-compass
ExecStart=/usr/bin/bash /opt/intraday-compass/deploy/update-bond-radar.sh
TimeoutStartSec=1200
